@page "/BasicMaze"
@using labyrinth

<PageTitle>Basic Maze Visualizer</PageTitle>

<h1>Enter your name</h1>
<input @bind="userName" />
<button @onclick="generateMaze">Generate Basic Maze</button>

<pre>
@foreach(var item in output)
{
  <p>
  @item
  </p>  
    
}
</pre>

@code
{
    string userName = "";
    IEnumerable<string> output = new List<string>();
    
    void generateMaze()
    {
        //bring over code from the Program.cs of the previous lab that generates the maze.
        MazeCell startLocation = MazeUtilities.mazeFor(userName);
        var solver = new MazeSolver();
        output = solver.ExploreMaze(startLocation).Select(node => node.ToString());
    }

}